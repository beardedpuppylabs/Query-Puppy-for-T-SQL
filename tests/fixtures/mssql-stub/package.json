{
  "name": "mssql",
  "displayName": "mssql test dependency stub",
  "version": "0.0.0",
  "publisher": "ms-mssql",
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "configuration": {
      "title": "mssql test dependency stub",
      "properties": {
        "mssql.intelliSense.enableSuggestions": {
          "type": "boolean",
          "default": true,
          "scope": "window"
        },
        "mssql.intelliSense.enableQuickInfo": {
          "type": "boolean",
          "default": true,
          "scope": "window"
        },
        "mssql.intelliSense.enableErrorChecking": {
          "type": "boolean",
          "default": true,
          "scope": "window"
        }
      }
    }
  }
}
